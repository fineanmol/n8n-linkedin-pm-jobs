# Secrets — never commit
.env
.env.example
workflow-backup-*.json

# n8n local data (DB, credentials, etc.)
.n8n/

# macOS
.DS_Store
.localized

# Python
__pycache__/
*.pyc
*.pyo
.venv*/
.venv-*/

# Node (wrangler helper)
node_modules/
package-lock.json
.wrangler/

# Scratch / one-off edit dumps
.tmp_*.js
.tmp_*.json

# Logs
*.log
/tmp/
linkedin-automation-complete.json

# Per-job tailored PDFs/JSON (keep master/ tracked)
applications/jobs/
applications/uploads/

# Runtime queues / progress / JD temp (regenerable)
applications/queues/
applications/apply_queue*.json
